{
  "name": "elegans-liquid-tabs",
  "version": "0.1.1",
  "description": "A React segmented control with an elastic travelling active state.",
  "private": false,
  "type": "module",
  "types": "./dist/index.d.ts",
  "style": "./dist/liquid-tabs.css",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/liquid-tabs.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/liquid-tabs.css"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "tsx --test src/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "npm test && npm run build && npm run typecheck && node scripts/verify-package.mjs && node scripts/verify-repository.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hxmzaehsan/elegans-liquid-tabs.git"
  },
  "bugs": {
    "url": "https://github.com/hxmzaehsan/elegans-liquid-tabs/issues"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "4.23.12",
    "typescript": "6.0.3"
  },
  "keywords": [
    "react",
    "tabs",
    "segmented-control",
    "animation"
  ],
  "license": "MIT"
}
